{
	"schemaVersion": 1,
	"id": "${modId}",
	"version": "${version}",
	"name": "${modName}",
	"description": "${modDescription}",
	"authors": [
		"${authors}"
	],
	"contributors": [
		"${contributors}"
	],
	"contact": {
		"homepage": "${homepage}",
		"issues": "${issues}",
		"sources": "${sources}"
	},
	"license": "${license}",
	"icon": "assets/antique_atlas/icon.png",
	"mixins": [
		"antique_atlas.mixins.json",
		"atlasbound.mixins.json"
	],
	"depends": {
		"minecraft": "${mc}",
		"fabricloader": ">=${fl}",
		"fabric-api": ">=${fapi}",
		"rosetta_library": ">=${rosetta}",
		"rosetta_networking": ">=${rosettaNetworking}",
		"syrup_library": ">=${syrupLibrary}"
	},
	"entrypoints": {
		"main": [
			"net.syrupstudios.atlasbound.loaders.fabric.FabricEntrypoint"
		],
		"client": [
			"net.syrupstudios.atlasbound.loaders.fabric.FabricClientEntrypoint"
		]
	}
}
